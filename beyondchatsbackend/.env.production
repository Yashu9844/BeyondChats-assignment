# Production Environment Variables for Railway
# Copy these to Railway's Environment Variables section

APP_NAME=BeyondChat
APP_ENV=production
APP_KEY=base64:XU1dk3L+2ZUa6CPozwxaGlMqkLpBwvDPjBdpznuFJmg=
APP_DEBUG=false
APP_URL=https://your-railway-app.railway.app

# Laravel Settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - Railway will provide these via $DATABASE_URL
# Or set individual values:
DB_CONNECTION=pgsql
# DB_HOST will be provided by Railway
# DB_PORT will be provided by Railway  
# DB_DATABASE will be provided by Railway
# DB_USERNAME will be provided by Railway
# DB_PASSWORD will be provided by Railway

# Session & Cache - Use database for Railway compatibility
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# CORS - Update with your frontend URL
SANCTUM_STATEFUL_DOMAINS=your-frontend-domain.com
SESSION_DOMAIN=.railway.app

# Mail (configure with your mail provider)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Trusted Proxies for Railway
TRUSTED_PROXIES=*
